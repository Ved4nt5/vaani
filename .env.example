# Vaani Environment Configuration
PORT=3000

# Gemini API Key (Automatically injected in Google AI Studio)
GEMINI_API_KEY=

# Optional Speech-to-Text API Keys
OPENAI_API_KEY=
GROQ_API_KEY=

# SMTP Email Configuration (Works with Gmail App Password, SendGrid, Mailgun, Brevo, AWS SES, or any custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vaani AI" <noreply@vaani.ai>

# Legacy / Alternative aliases also supported:
VAANI_MAIL_USERNAME=
VAANI_MAIL_PASSWORD=
VAANI_MAIL_HOST=smtp.gmail.com
VAANI_MAIL_PORT=587
